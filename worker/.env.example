# MQTT broker (HiveMQ Cloud pulsuz plan tövsiyə olunur — cloud.hivemq.com)
MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# Supabase (Project Settings → API-dən götürün)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram bot (BotFather-dən token, öz chat_id-nizi @userinfobot ilə tapın)
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# Gərginlik həddləri (V)
VOLTAGE_LOW=195
VOLTAGE_HIGH=245

# Gecə saatlarında (01:00–05:00) bu kW-dan yuxarı yük "şübhəli/sızma" sayılsın
ANOMALY_NIGHT_THRESHOLD_KW=0.3

# Azərişıq tarifi
TARIFF_LOW=0.08
TARIFF_HIGH=0.10
TARIFF_THRESHOLD=300
